<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Applied Chemistry Bank - 135Q</title><style>@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@600;800&display=swap');*{box-sizing:border-box;font-family:'Cairo',system-ui}body{margin:0;min-height:100vh;background:#0a1729;display:flex;justify-content:center;padding:14px;color:#fff}.wrapper{width:100%;max-width:500px}.card-main{background:linear-gradient(180deg,#12304f,#0d2038);border-radius:28px;padding:28px 20px;border:1px solid #1e3a5f;box-shadow:0 20px 60px rgba(0,0,0,.5);text-align:center}.laptop{font-size:60px;filter:drop-shadow(0 0 20px rgba(34,211,238,.6))}h1{margin:10px 0 4px;font-size:24px;font-weight:800;line-height:1.3}.sub{color:#5ec8e8;font-size:12px;margin:8px 0 18px;line-height:1.7}.dev{color:#5a7a9a;font-size:10px;letter-spacing:2px;margin:14px 0 2px}.dev-name{color:#22d3ee;font-weight:800;letter-spacing:2px;font-size:15px;margin-bottom:16px}.filters{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-start;margin:12px 0}.filt{background:#0f2a4a;border:1px solid #1e3f66;border-radius:20px;padding:7px 12px;font-size:11px;cursor:pointer;color:#a8c0d8}.filt.active{border-color:#22d3ee;color:#22d3ee;box-shadow:0 0 10px rgba(34,211,238,.3)}.count{color:#6b8aaa;font-size:13px;margin:14px 0}.count b{color:#22d3ee}.start-btn{width:100%;background:linear-gradient(90deg,#0e8fb0,#149cc0);border:none;border-radius:16px;padding:15px;font-size:18px;font-weight:800;color:#fff;cursor:pointer;box-shadow:0 8px 24px rgba(14,143,176,.4)}#quizView{display:none}.topbar{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:10px 0;position:sticky;top:8px;z-index:5}.badge{background:#132a46;border:1px solid #1e3f66;border-radius:20px;padding:6px 10px;font-size:11px;font-weight:700}.qcard{background:#fff;color:#111;border-radius:18px;padding:14px;margin:10px 0;text-align:left;direction:ltr}.qtitle{font-weight:800;font-size:13px;margin:6px 0 10px;line-height:1.5}.opt{border:1.5px solid #e2e8f0;border-radius:12px;padding:9px;margin:7px 0;cursor:pointer;display:flex;gap:8px;align-items:center;font-size:12px}.opt.correct{background:#dcfce7!important;border-color:#22c55e!important}.opt.wrong{background:#fee2e2!important;border-color:#ef4444!important}.letter{background:#e2e8f0;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:11px}.back{background:transparent;border:1px solid #2a4a70;color:#7fb8d8;border-radius:12px;padding:6px 12px;cursor:pointer;margin:8px 0}</style></head><body><div class="wrapper"><div id="landing" class="card-main"><div class="laptop">🧪</div><h1>Applied Chemistry<br>Electrochemistry Bank</h1><div class="sub">Electrochemistry · Corrosion · Electrolysis · Water Treatment · 135 Questions<br>Prof. Dr. Eid Gouda</div><div class="dev">DESIGNED & DEVELOPED BY</div><div class="dev-name">ENG MOHAMED GALAL</div><div style="text-align:right;color:#8fb3d0;font-size:13px;margin-top:12px">اختر الموضوع</div><div class="filters" id="filters"></div><div class="count">عدد الأسئلة: <b id="qcount">135</b> سؤال</div><button class="start-btn" onclick="startQuiz()">ابدأ الاختبار ▶</button><div class="dev" style="margin-top:20px">DESIGNED & DEVELOPED BY</div><div class="dev-name">ENG MOHAMED GALAL</div></div><div id="quizView"><button class="back" onclick="showLanding()">← رجوع</button><div class="topbar"><div class="badge" id="prog">0/135</div><div class="badge" style="color:#22c55e">✅ <span id="ok">0</span></div><div class="badge" style="color:#ef4444">❌ <span id="bad">0</span></div><div class="badge">📊 <span id="perc">0%</span></div></div><div id="quiz"></div></div></div><script>const allQuestions=[{q:"1. Batteries provide the electric current to …..",options:["start our automobiles","pocket calculators","digital watches","heart pacemakers, radios, and tape recorders.","all of these"],correct:4,cat